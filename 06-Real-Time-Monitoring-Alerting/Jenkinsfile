pipeline {
    agent any
    stages {
        stage('Pre-check Docker') {
            steps {
                sh 'docker --version'
                sh 'docker info > /dev/null'
                echo 'Docker is available and running'
            }
        }
        stage('Setup Workspace') {
            steps {
                sh '''
                cp /var/jenkins_home/delivery_src/delivery_metrics.py .
                cp /var/jenkins_home/delivery_src/prometheus.yml .
                cp /var/jenkins_home/delivery_src/alert_rules.yml .
                cp /var/jenkins_home/delivery_src/Dockerfile .
                ls -l
                '''
            }
        }
        stage('Build Docker Image') {
            steps {
                sh 'docker build -t delivery_metrics .'
            }
        }
        stage('Run Application') {
            steps {
                sh '''
                docker rm -f delivery_metrics || true
                docker run -d -p 8001:8000 --name delivery_metrics delivery_metrics
                '''
            }
        }
        stage('Verify Prometheus and Grafana') {
            steps {
                sh 'docker ps --filter name=delivery'
            }
        }
    }
}
